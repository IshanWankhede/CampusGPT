# CampusGPT Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
# REQUIRED. Allowed values: development | staging | production
# Any other value causes startup to fail immediately.
#
# Security guards are skipped in development.
# All guards G1–G8 are enforced in staging and production.
ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED. PostgreSQL connection string.
# SQLite is not supported — every migration requires PostgreSQL.
#
# Reserved database names rejected in staging/production:
#   campusgpt        (development database)
#   campusgpt_dev    (development alias)
#   campusgpt_test   (automated test database)
#
# Recommended names by environment:
#   Development : campusgpt
#   Staging     : campusgpt_staging
#   Production  : campusgpt_prod
#
# Examples:
#   Local Docker development:
#     DATABASE_URL=postgresql+psycopg2://campusgpt:PASSWORD@localhost:5433/campusgpt
#   Production:
#     DATABASE_URL=postgresql+psycopg2://DB_USER:DB_PASSWORD@DB_HOST:5432/campusgpt_prod
DATABASE_URL=postgresql+psycopg2://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME

# ── JWT Authentication ────────────────────────────────────────────────────────
# REQUIRED.
# In staging/production:
#   • Must NOT be the development default.
#   • Must NOT contain the word "development".
#   • Must be at least 32 characters.
# Generate a secure value: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# In staging/production: must NOT include http://localhost
# Example: CORS_ORIGINS=https://app.example.com,https://www.example.com
CORS_ORIGINS=http://localhost:5173

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Base URL of the deployed frontend.
# Used in Google OAuth callbacks and transactional email links.
FRONTEND_URL=http://localhost:5173

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# Both must be set or both must be empty.
# Leave both empty to disable Google OAuth login entirely.
# Partial configuration (one set, one empty) causes startup to fail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Email via Resend (optional) ───────────────────────────────────────────────
# Leave RESEND_API_KEY empty to disable transactional email.
# Required for OTP login, password reset, and notification emails.
# Obtain a key at: https://resend.com
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ── LLM Integration (optional — not yet implemented) ─────────────────────────
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# ── Embedding Model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

