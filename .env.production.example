# CampusGPT — Production Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# This template lists REQUIRED environment variable names only.
# Do NOT place default secrets, dummy credentials, or development passwords here.
# Copy to .env.production on the production host and populate with secure values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
ENV=production

# ── Database Credentials ──────────────────────────────────────────────────────
# Production PostgreSQL credentials (use dedicated campusgpt_prod database)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=campusgpt_prod
DATABASE_URL=postgresql+psycopg2://<POSTGRES_USER>:<POSTGRES_PASSWORD>@campusgpt_db:5432/campusgpt_prod

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32 (minimum 32 characters, no "development")
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Networking & CORS ─────────────────────────────────────────────────────────
# Comma-separated list of production HTTPS origins (no localhost)
CORS_ORIGINS=https://app.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com

# ── Email Service (Resend) ───────────────────────────────────────────────────
# API key from resend.com and verified domain sender address
RESEND_API_KEY=
EMAIL_FROM=notifications@yourdomain.com

# ── Google OAuth (Optional) ───────────────────────────────────────────────────
# Must both be set or both be empty. Must use production redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.yourdomain.com/api/v1/auth/google/callback

