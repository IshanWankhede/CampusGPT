# CampusGPT — Environment Variables (Compose-level reference)
# See backend/.env.example for full documentation of every variable.
# Copy to backend/.env and fill in real values.
# Never commit backend/.env to version control.

# REQUIRED. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET_MIN_32_CHARS
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
DATABASE_URL=postgresql://campusgpt:campusgpt_dev@localhost:5433/campusgpt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=claude-sonnet-5
EMBEDDING_MODEL=all-MiniLM-L6-v2
CORS_ORIGINS=http://localhost:5173
ENV=development
# Leave both empty to disable Google OAuth, or set both together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
